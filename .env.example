DATABASE_URL="postgresql://pulseboard:pulseboard@localhost:5432/pulseboard?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-long-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=7
NODE_ENV="development"
# Set this only when the client is hosted separately from the API, for example on Vercel.
VITE_API_ORIGIN=""
